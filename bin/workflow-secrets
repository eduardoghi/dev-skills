#!/usr/bin/env python3
"""Find GitHub Actions steps that run third-party code with a secret in their environment.

  workflow-secrets FILE...

A secret in the `env` of a step, of its job or of the whole workflow can be read by everything the
step runs. Package installs run maintainer scripts, builds run the build scripts of dependencies
and a script piped from curl runs whatever it holds. Each step that has a secret in scope and runs
one of those is printed as `FILE:LINE`, with the secret and the command. Exits with 1 when it finds
one, 2 when a file can't be read, and 0 otherwise.

`secrets.GITHUB_TOKEN` doesn't count, since its permissions come from the workflow. A secret passed
to an action through `with` isn't checked either, as what the action runs isn't in the file. The
commands are matched as text and not parsed as shell, so one inside a quoted string or a comment
of the script is reported too.

Needs PyYAML.
"""
import re
import sys

import yaml

# Commands that run code from outside the repository. Kept short and explicit, so a finding always
# names something that really runs third-party code.
COMMANDS = re.compile(
    r"""(?x)
    \b(?:apt-get|apt|dnf|yum|zypper|brew)\s+(?:-\S+\s+)*install\b
    | \bapk\s+(?:-\S+\s+)*add\b
    | \b(?:pip3?|python3?\s+-m\s+pip|uv\s+pip)\s+install\b
    | \buv\s+tool\s+install\b
    | \b(?:npm|pnpm)\s+(?:install|i|ci)\b
    | \byarn(?:\s+(?:install|add)\b|\s*$)
    | \bcargo\s+(?:install|build)\b
    | \b(?:go|gem)\s+install\b
    | \b(?:curl|wget)\b[^|\n]*\|\s*(?:sudo\s+)?(?:ba|z)?sh\b
    """,
    re.MULTILINE,
)
SECRET = re.compile(r"\bsecrets\.([A-Za-z_][A-Za-z0-9_]*)")


def child(node, key):
    """The value under `key` in a YAML mapping node, or None."""
    if isinstance(node, yaml.MappingNode):
        for name, value in node.value:
            if isinstance(name, yaml.ScalarNode) and name.value == key:
                return value
    return None


def secrets_in(env):
    """Names of the secrets an `env` mapping node puts in scope."""
    names = []
    if isinstance(env, yaml.MappingNode):
        for _, value in env.value:
            if isinstance(value, yaml.ScalarNode):
                names += [n for n in SECRET.findall(value.value) if n != "GITHUB_TOKEN"]
    return names


def first_line(script):
    """Line in the file, from 1, where the text of a scalar node starts."""
    line = script.start_mark.line + 1
    # A block scalar starts after its `|` or `>` indicator.
    return line + 1 if script.style in ("|", ">") else line


def check(path):
    with open(path, encoding="utf-8") as file:
        root = yaml.compose(file)
    findings = []
    workflow = secrets_in(child(root, "env"))
    jobs = child(root, "jobs")
    if not isinstance(jobs, yaml.MappingNode):
        return findings
    for job_name, job in jobs.value:
        job_secrets = workflow + secrets_in(child(job, "env"))
        steps = child(job, "steps")
        if not isinstance(steps, yaml.SequenceNode):
            continue
        for step in steps.value:
            in_scope = job_secrets + secrets_in(child(step, "env"))
            script = child(step, "run")
            if not in_scope or not isinstance(script, yaml.ScalarNode):
                continue
            for match in COMMANDS.finditer(script.value):
                line = first_line(script) + script.value.count("\n", 0, match.start())
                name = child(step, "name")
                label = name.value if isinstance(name, yaml.ScalarNode) else job_name.value
                start = script.value.rfind("\n", 0, match.start()) + 1
                command = script.value[start:].split("\n", 1)[0].strip()
                findings.append(
                    f"{path}:{line}: '{label}' runs `{command}` with "
                    f"{', '.join(sorted(set(in_scope)))} in its environment"
                )
    return findings


def main(paths):
    if not paths:
        print("usage: " + __doc__.strip().splitlines()[2].strip(), file=sys.stderr)
        return 2
    status = 0
    for path in paths:
        try:
            findings = check(path)
        except (OSError, yaml.YAMLError) as error:
            print(f"{path}: {error}", file=sys.stderr)
            status = 2
            continue
        for finding in findings:
            print(finding)
        if findings and status == 0:
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
